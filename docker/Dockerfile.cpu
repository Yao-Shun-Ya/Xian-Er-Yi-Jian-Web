# 腺而易见 · CPU 版容器（PyTorch 2.5.1 CPU wheel）
# 构建（在仓库根目录执行）：
#   docker build -f docker/Dockerfile.cpu -t mgd-seg:cpu .
# 运行：
#   docker run -p 7860:7860 \
#     -v /path/images:/data -v /path/weights:/weights -v /path/outputs:/outputs \
#     mgd-seg:cpu
# 说明：CPU 版本可跑诊断、评估、doctor 与冒烟训练；完整训练建议使用 CUDA 版。
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY docs/engineering ./docs/engineering
COPY mgd ./mgd

RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.5.1 \
    && pip install ".[ui]"

RUN useradd --create-home --uid 10001 mgd \
    && mkdir -p /data /weights /outputs \
    && chown -R mgd:mgd /app /data /weights /outputs

USER mgd

ENV MGD_HOME=/app \
    MGD_DATA_DIR=/data \
    MGD_MODEL_DIR=/weights \
    MGD_OUTPUT_DIR=/outputs \
    MGD_PRETRAINED_DIR=/weights/pretrained \
    MGD_HOST=0.0.0.0 \
    MGD_PORT=7860 \
    MGD_DEVICE=cpu

EXPOSE 7860
VOLUME ["/data", "/weights", "/outputs"]

ENTRYPOINT ["mgd-ui"]
