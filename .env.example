# 复制为 .env.local 后按需修改。
# 上线前必须更换 ADMIN_PASSWORD 与 SESSION_SECRET，禁止使用示例值。

# 单管理员口令（只允许在服务端读取）
ADMIN_PASSWORD=change-me-before-deploy

# 会话签名密钥，至少 32 字节；生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-byte-secret

# SQLite 数据库文件。生产环境建议使用绝对路径，避免 cwd 漂移。
DATABASE_PATH=./xianeryijian.db

# 应用端口；next start / next dev 会读取该变量。
PORT=3001
